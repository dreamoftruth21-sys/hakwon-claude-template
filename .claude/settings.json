{
  "model": "claude-sonnet-5-5",
  "autoCompactWindow": 300000,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(py 공용/*)",
      "Bash(py -X utf8 공용/*)",
      "Bash(node 공용/*)",
      "Bash(clasp *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File 공용/설치/*)",
      "PowerShell(py 공용/*)",
      "PowerShell(py -X utf8 공용/*)",
      "PowerShell(node 공용/*)",
      "PowerShell(clasp *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File 공용/설치/*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"${CLAUDE_PROJECT_DIR}/공용/사용기록/기록.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"${CLAUDE_PROJECT_DIR}/공용/사용기록/기록.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"${CLAUDE_PROJECT_DIR}/공용/사용기록/기록.py\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "py -X utf8 \"${CLAUDE_PROJECT_DIR}/공용/사용기록/기록.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
